---
import Icon from './Icon.astro';
import { WA } from '../consts';
interface Props { href?: string }
const { href = WA.general } = Astro.props;
---
<a class="fab" href={href} target="_blank" rel="noopener" aria-label="Chat with Applane on WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .fab {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    width: 58px; height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--green);
    color: #fff;
    box-shadow: 0 10px 30px -8px rgb(11 138 71 / 0.6);
    transform: translateY(120px) scale(0.6);
    opacity: 0;
    transition: transform 0.6s var(--ease), opacity 0.4s, background-color 0.3s;
  }
  .fab.is-on {
    transform: none;
    opacity: 1;
    animation: pulse-ring 2.4s 1s 3;
  }
  .fab:hover { background: var(--green-ink); }
  @media (min-width: 960px) {
    .fab { right: 28px; bottom: 28px; }
  }
  :global(html.menu-open) .fab { opacity: 0; pointer-events: none; }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('.fab')!;
  const toggle = () => fab.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.6);
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();
</script>
