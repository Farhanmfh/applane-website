---
import Icon from './Icon.astro';
import { WA } from '../consts';
---
<div class="stage" data-stage>
  <div class="stage__sticky" aria-hidden="true">
    <svg class="stage__fallback" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMax slice">
      <defs>
        <linearGradient id="laneFade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#18D26E" stop-opacity="0" />
          <stop offset="0.6" stop-color="#18D26E" stop-opacity="0.55" />
          <stop offset="1" stop-color="#9BE8BE" stop-opacity="0.9" />
        </linearGradient>
      </defs>
      {Array.from({ length: 11 }, (_, i) => (
        <path d={`M${600 + (i - 5) * 14} 430 L${600 + (i - 5) * 210} 800`} />
      ))}
    </svg>
    <canvas class="stage__canvas"></canvas>
    <div class="stage__glow"></div>
  </div>

  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow intro">Custom apps &amp; websites · Hyderabad</p>
      <h1 id="hero-title" class="intro" style="--d:80">Software that fits how your <span class="mark">business already works.</span></h1>
      <p class="hero__lede intro" style="--d:260">
        We build apps around your items, your bill format and your staff. And websites that look and move like a premium brand. We set it all up, load your data and stay on WhatsApp for support.
      </p>
      <div class="btn-row intro" style="--d:400">
        <a class="btn btn--bright" href={WA.general} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chat on WhatsApp</a>
        <a class="btn btn--ghost" href="#work">See our work <Icon name="arrow" /></a>
      </div>
      <p class="hero__note intro" style="--d:520"><span class="chip chip--dot">Websites from ₹1,999</span></p>
    </div>
    <a class="hero__scroll" href="#what" aria-label="Scroll to what we do"><span></span></a>
  </section>

  <section class="panel on-dark" id="what" data-panel aria-labelledby="apps-title">
    <div class="wrap panel__inner">
      <div class="panel__body">
        <p class="eyebrow">01 · Custom apps</p>
        <h2 id="apps-title" data-split>Your business. Your rules. <span class="mark">Your app.</span></h2>
        <p data-reveal>Generic apps make you change how you work to fit the software. We do it the other way round. We learn how your business runs, then build the app around it.</p>
        <ul class="ticks" data-reveal style="--d:120">
          <li>Your items, your rates, your bill format</li>
          <li>Staff roles: who can bill, who can edit</li>
          <li>Works on phone, tablet and desktop</li>
          <li>We load your data and train your staff</li>
        </ul>
        <a class="link-arrow" href="/work/" data-reveal style="--d:200">See the apps we've built <Icon name="arrow" /></a>
      </div>
      <svg class="panel__art" viewBox="0 0 200 360" aria-hidden="true">
        <rect x="10" y="10" width="180" height="340" rx="30" />
        <path d="M40 54h120M40 100h70M130 100h30M40 130h56M130 130h30M40 160h80M130 160h30M40 190h60M130 190h30M40 230h120M110 252h50" />
        <rect x="45" y="290" width="110" height="30" rx="15" />
      </svg>
    </div>
  </section>

  <section class="panel on-dark" data-panel aria-labelledby="web-title">
    <div class="wrap panel__inner">
      <div class="panel__body">
        <p class="eyebrow">02 · Premium websites</p>
        <h2 id="web-title" data-split>Websites that move like a <span class="mark">premium brand.</span></h2>
        <p data-reveal>3D, scroll-driven motion and interactive tools, built in code. Still fast on a mid-range phone, and built to rank on Google.</p>
        <ul class="ticks" data-reveal style="--d:120">
          <li>Booking and contact forms built in</li>
          <li>SEO and structured data from day one</li>
          <li>Loads fast, then adds the motion</li>
          <li>Static websites from ₹1,999</li>
        </ul>
        <a class="link-arrow" href="/websites/" data-reveal style="--d:200">See website work <Icon name="arrow" /></a>
      </div>
      <svg class="panel__art" viewBox="0 0 360 240" aria-hidden="true">
        <rect x="6" y="6" width="348" height="228" rx="16" />
        <path d="M6 38h348M40 90h110M40 112h80M40 146h120M40 160h100M40 174h70" />
        <circle cx="24" cy="22" r="4" /><circle cx="38" cy="22" r="4" /><circle cx="52" cy="22" r="4" />
        <circle cx="262" cy="140" r="62" />
        <ellipse cx="262" cy="140" rx="62" ry="22" />
        <ellipse cx="262" cy="140" rx="24" ry="62" />
        <rect x="40" y="194" width="74" height="22" rx="11" />
      </svg>
    </div>
  </section>
</div>

<style>
  /* clip-path (not overflow) keeps the sticky canvas inside the stage without breaking sticky. */
  .stage { position: relative; background: var(--dark); color: var(--on-dark); isolation: isolate; clip-path: inset(0); }
  .stage__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .stage__canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .stage__fallback {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transition: opacity 1s var(--ease);
  }
  .stage__fallback path {
    fill: none; stroke: url(#laneFade); stroke-width: 2;
    stroke-dasharray: 10 18;
    animation: lane-run 1.8s linear infinite;
  }
  @keyframes lane-run { to { stroke-dashoffset: -56; } }
  .stage.has-3d .stage__canvas { opacity: 1; }
  .stage.has-3d .stage__fallback { opacity: 0; }
  .stage__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 50% at 50% 100%, rgb(11 138 71 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 85% 10%, rgb(24 210 110 / 0.1), transparent 70%);
  }

  .hero, .panel { position: relative; z-index: 1; }
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 96px;
  }
  .hero__inner { position: relative; }
  /* Shade behind the hero copy so the particle lanes never fight the text. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(12 15 14 / 0.1) 0%, rgb(12 15 14 / 0.72) 32%, rgb(12 15 14 / 0.72) 78%, rgb(12 15 14 / 0) 100%);
  }
  @media (min-width: 900px) {
    .hero::before { background: linear-gradient(90deg, rgb(12 15 14 / 0.9) 0%, rgb(12 15 14 / 0.6) 42%, rgb(12 15 14 / 0) 70%); }
  }
  .hero__lede { text-shadow: 0 1px 14px rgb(12 15 14 / 0.9); }
  .hero h1 { color: #fff; max-width: 13ch; font-size: clamp(2.7rem, 1.6rem + 5.4vw, 6.6rem); }
  .hero__lede { font-size: var(--step-1); color: #c9d6cf; max-width: 54ch; margin: 8px 0 34px; line-height: 1.55; }
  .hero__note { margin: 28px 0 0; }
  .hero__note .chip { background: rgb(24 210 110 / 0.12); color: #bff3d6; }
  .hero__scroll {
    position: absolute; left: 50%; bottom: 28px; translate: -50% 0;
    width: 28px; height: 46px; border-radius: 999px; border: 1.5px solid rgb(255 255 255 / 0.35);
  }
  .hero__scroll span {
    position: absolute; left: 50%; top: 9px; width: 4px; height: 9px; margin-left: -2px; border-radius: 4px;
    background: var(--green-bright); animation: scroll-dot 1.8s var(--ease) infinite;
  }
  @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(16px); opacity: 0; } }

  .panel {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 80px 56px;
  }
  .panel__inner { display: grid; gap: 32px; align-items: center; width: 100%; }
  .panel__body {
    max-width: 540px;
    padding: 24px;
    margin-inline: -8px;
    border-radius: var(--radius);
    background: rgb(12 15 14 / 0.72);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 0.06);
  }
  .panel__body h2 { color: #fff; font-size: var(--step-4); }
  .panel__body p { color: #c3d0c9; }
  .panel__body .ticks { margin: 20px 0 26px; color: #e3ebe6; }
  .panel__art {
    order: -1;
    width: min(46vw, 220px);
    margin-inline: auto;
    fill: none;
    stroke: var(--green-bright);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .panel:last-child .panel__art { width: min(70vw, 360px); }
  .stage.has-3d .panel__art { visibility: hidden; }

  @media (min-width: 900px) {
    .panel { align-items: center; padding-block: 120px; }
    .panel__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .panel__body { padding: 0; margin: 0; background: none; border: 0; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .panel__art { order: 0; width: min(100%, 260px); }
    .panel:last-child .panel__art { width: min(100%, 440px); }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('.stage__canvas');
  const panels = stage ? Array.from(stage.querySelectorAll<HTMLElement>('[data-panel]')) : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  const hasWebGL = () => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };

  if (stage && canvas && !reduce && !saveData && hasWebGL()) {
    const boot = () =>
      import('../scripts/lanes')
        .then(({ start }) => start({ canvas, stage, panels, onReady: () => stage.classList.add('has-3d') }))
        .catch(() => { /* keep the static fallback */ });
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 1800 }) : setTimeout(cb, 250);
    if (document.readyState === 'complete') idle(boot);
    else window.addEventListener('load', () => idle(boot), { once: true });
  }
</script>
