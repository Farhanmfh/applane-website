---
import type { Crumb } from '../schema';
interface Props { eyebrow?: string; title: string; lede?: string; crumbs?: Crumb[]; tone?: 'light' | 'dark' | 'mint'; class?: string }
const { eyebrow, title, lede, crumbs, tone = 'light', class: cls } = Astro.props;
---
<section class:list={['page-hero', `page-hero--${tone}`, { 'on-dark': tone === 'dark' }, cls]}>
  <div class="page-hero__lanes" aria-hidden="true">
    <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMax slice">
      {Array.from({ length: 9 }, (_, i) => (
        <path d={`M${900 + (i - 4) * 10} 120 L${900 + (i - 4) * 120} 600`} />
      ))}
    </svg>
  </div>
  <div class="wrap">
    {crumbs && (
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow" data-reveal="fade">{eyebrow}</p>}
    <h1 data-split set:html={title} />
    {lede && <p class="lede" data-reveal style="--d:400">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero--dark { background: var(--dark); color: var(--on-dark); }
  .page-hero--dark h1 { color: #fff; }
  .page-hero--dark .lede { color: #c3d0c9; }
  .page-hero--mint { background: var(--mint); }
  .page-hero h1 { max-width: 16ch; }
  .page-hero .wrap { position: relative; z-index: 1; }
  .page-hero__lanes { position: absolute; inset: 0; pointer-events: none; opacity: 0.5; }
  .page-hero__lanes svg { width: 100%; height: 100%; }
  .page-hero__lanes path {
    fill: none; stroke: var(--green); stroke-opacity: 0.22; stroke-width: 1.5; stroke-dasharray: 8 16;
    animation: hero-lane 2.6s linear infinite;
  }
  .page-hero--dark .page-hero__lanes path { stroke: var(--green-bright); stroke-opacity: 0.35; }
  @keyframes hero-lane { to { stroke-dashoffset: -48; } }
  @media (max-width: 760px) { .page-hero__lanes { opacity: 0.3; } }
</style>
